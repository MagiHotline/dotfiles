# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"

plugins=(git)

source $ZSH/oh-my-zsh.sh

# ALIASES

# eza
alias l="eza --icons --group-directories-first -l  --no-filesize --long --git --no-time --no-user"
alias ll="eza --icons --group-directories-first -la  --no-filesize --long --git --no-time --no-user"
alias ls="eza"
alias tree="eza --tree"

alias zshconfig="mate ~/.zshrc"
alias ohmyzsh="mate ~/.oh-my-zsh"

# Zoxide configuration
eval "$(zoxide init --cmd cd zsh)"

export PATH="/Library/TeX/texbin:$PATH"
export C_INCLUDE_PATH=/opt/homebrew/include/SDL2:$C_INCLUDE_PATH
export LIBRARY_PATH=/opt/homebrew/lib:$LIBRARY_PATH
export PATH="/Users/paoloimbriani/.cargo/bin":$PATH

[ -f "/Users/paoloimbriani/.ghcup/env" ] && . "/Users/paoloimbriani/.ghcup/env" # ghcup-env
# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
__conda_setup="$('/Users/paoloimbriani/miniconda3/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "/Users/paoloimbriani/miniconda3/etc/profile.d/conda.sh" ]; then
        . "/Users/paoloimbriani/miniconda3/etc/profile.d/conda.sh"
    else
        export PATH="/Users/paoloimbriani/miniconda3/bin:$PATH"
    fi
fi
unset __conda_setup
# <<< conda initialize <<<

# GHCUP
export PATH="$HOME/.ghcup/bin:$PATH"

# CABAL
export PATH="$HOME/.cabal/bin:$PATH"

# LOCAL
export PATH="$HOME/.local/bin:$PATH"

# BASE EDITOR
alias yazi="EDITOR=zed yazi"

# BROWSER
export BROWSER="brave"

# GCC
# export CC=/opt/homebrew/Cellar/gcc/14.2.0_1/bin/gcc-14
# export CXX=/opt/homebrew/Cellar/gcc/14.2.0_1/bin/g++-14
export JAVA_HOME=$(/usr/libexec/java_home -v21)

# SQL
export PATH="/opt/homebrew/opt/mysql/bin:$PATH"
export PATH="/opt/homebrew/opt/mysql@8.4/bin:$PATH"

# VSCODE
export PATH="$PATH:/Applications/Visual Studio Code.app/Contents/Resources/app/bin"

# Add cargo
export PATH="$HOME/.cargo/bin:$PATH"

# Dependecy for ANTLR_JAR

# Kiro CLI post block. Keep at the bottom of this file.
[[ -f "${HOME}/Library/Application Support/kiro-cli/shell/zshrc.post.zsh" ]] && builtin source "${HOME}/Library/Application Support/kiro-cli/shell/zshrc.post.zsh"

export PATH="/opt/homebrew/opt/postgresql@15/bin:$PATH"
export PATH="/opt/homebrew/opt/openjdk@21/bin:$PATH"

# Starship
eval "$(starship init zsh)"


